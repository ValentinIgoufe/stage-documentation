{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "description": "Ma cnfiguration",
  "fetchChangeLogs": "off",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "recreateWhen": "always",
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "composerIgnorePlatformReqs": ["ext-*", "lib-*", "php"],
  "docker-compose": {
    "fileMatch": [
      "(^|/)docker-compose[^/]*\\.ya?ml$",
      "(^|/)docker-compose\\.ya?ml\\.[^/]+$"
    ]
  },
  "packageRules": [
    {
      "description": "Maj environnement PHP : Dockerfile, composer.json et gitlab-ci",
      "groupName": "MAJ env PHP",
      "groupSlug": "maj-env-php",
      "semanticCommitType": "chore",
      "semanticCommitScope": "maj-env-php",
      "commitMessageAction": "Mise à jour env PHP :",
      "matchPackageNames": ["php", "docker.io/library/php", "php-fpm", "containerbase/php-prebuild"],
      "matchManagers": ["composer", "dockerfile", "gitlabci", "custom.regex"],
      "postUpdateOptions": ["composerWithAll"]
    },
    {
      "enabled": true,
      "description": "MAJs Majeures",
      "groupName": "MAJ majeures",
      "groupSlug": "maj-majeures",
      "semanticCommitType": "chore",
      "semanticCommitScope": "maj-majeures",
      "commitMessageAction": "Mise à jour majeures :",
      "matchManagers": ["composer", "npm", "gitlabci", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "excludePackageNames": ["php", "docker.io/library/php", "library/php", "php-fpm", "containerbase/php-prebuild"],
      "excludePackagePatterns": [
        "^php:",
        "^php-",
        "^docker\\.io/library/php:",
        "^containerbase/php-prebuild:"
      ],
      "dependencyDashboardApproval": false,
      "postUpdateOptions": ["composerWithAll", "npmDedupe"]
    },
    {
      "description": "MAJs mineures, patches et pinning global",
      "groupName": "MAJ mineures",
      "groupSlug": "maj-mineures",
      "semanticCommitType": "chore",
      "semanticCommitScope": "maj-mineures",
      "commitMessageAction": "Mise à jour mineures :",
      "matchManagers": ["composer", "npm", "gitlabci", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "bump", "pin", "digest", "pinDigest"],
      "excludePackageNames": ["php", "docker.io/library/php", "php-fpm", "containerbase/php-prebuild"],
      "excludePackagePatterns": [
        "^php:",
        "^php-",
        "^docker\\.io/library/php:",
        "^containerbase/php-prebuild:"
      ],
      "postUpdateOptions": ["composerWithAll", "npmDedupe"],
      "automerge": true
    },
    {
      "description": "Labels par technologie",
      "matchManagers": ["npm"],
      "labels": ["npm"]
    },
    {
      "matchManagers": ["composer"],
      "labels": ["composer"]
    },
    {
      "matchManagers": ["dockerfile"],
      "labels": ["dockerfile"]
    },
    {
      "matchManagers": ["docker-compose"],
      "labels": ["docker-compose"]
    },
    {
      "matchManagers": ["gitlabci", "custom.regex"],
      "labels": ["gitlabci"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Détecter et mettre à jour la variable globale PHP_IMAGE dans la CI",
      "managerFilePatterns": ["/(^|/)\\.gitlab-ci\\.ya?ml$/"],
      "matchStrings": [
        "PHP_IMAGE:\\s*[\"']?(?<depName>php):(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}